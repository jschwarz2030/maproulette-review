{
  "name": "maproulette-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4201",
    "dev:plugin": "concurrently -k \"npm:watch\" \"npm:preview\"",
    "watch": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview --port 4201",
    "serve:min": "npm run build && vite preview --host --port 4201",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:local": "npm run build && node scripts/deploy-local.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
